{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AutoReviewDispositionActor": {
      "enum": [
        "user",
        "agent",
        "system"
      ],
      "type": "string"
    },
    "AutoReviewFindingDisposition": {
      "enum": [
        "needsAttention",
        "repairing",
        "deferred",
        "obsolete"
      ],
      "type": "string"
    },
    "AutoReviewFindingDispositionRecord": {
      "properties": {
        "actor": {
          "$ref": "#/definitions/AutoReviewDispositionActor"
        },
        "disposition": {
          "$ref": "#/definitions/AutoReviewFindingDisposition"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "updatedAt": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "actor",
        "disposition",
        "updatedAt"
      ],
      "type": "object"
    }
  },
  "properties": {
    "findingDisposition": {
      "$ref": "#/definitions/AutoReviewFindingDispositionRecord"
    },
    "runId": {
      "type": "string"
    }
  },
  "required": [
    "findingDisposition",
    "runId"
  ],
  "title": "AutoReviewDispositionWriteResponse",
  "type": "object"
}
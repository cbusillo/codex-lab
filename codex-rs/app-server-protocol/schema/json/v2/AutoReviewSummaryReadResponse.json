{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AutoReviewBudget": {
      "properties": {
        "maxElapsedMs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "maxFindings": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "maxOutputBytes": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "maxScopeBytes": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "maxTotalTokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "maxElapsedMs",
        "maxFindings",
        "maxOutputBytes",
        "maxScopeBytes",
        "maxTotalTokens"
      ],
      "type": "object"
    },
    "AutoReviewDiagnosticsSummary": {
      "properties": {
        "cancelledRuns": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "compact": {
          "type": "string"
        },
        "duplicateSkippedRuns": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "failedRuns": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "inFlightRuns": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "lostRuns": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "recentRuns": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "skippedRuns": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "supersededRuns": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "suppressedStaleRuns": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "terminalRuns": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "cancelledRuns",
        "compact",
        "duplicateSkippedRuns",
        "failedRuns",
        "inFlightRuns",
        "lostRuns",
        "recentRuns",
        "skippedRuns",
        "supersededRuns",
        "suppressedStaleRuns",
        "terminalRuns"
      ],
      "type": "object"
    },
    "AutoReviewDispositionActor": {
      "enum": [
        "user",
        "agent",
        "system"
      ],
      "type": "string"
    },
    "AutoReviewFindingDisposition": {
      "enum": [
        "needsAttention",
        "repairing",
        "deferred",
        "obsolete"
      ],
      "type": "string"
    },
    "AutoReviewFindingDispositionRecord": {
      "properties": {
        "actor": {
          "$ref": "#/definitions/AutoReviewDispositionActor"
        },
        "disposition": {
          "$ref": "#/definitions/AutoReviewFindingDisposition"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "updatedAt": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "actor",
        "disposition",
        "updatedAt"
      ],
      "type": "object"
    },
    "AutoReviewFreshness": {
      "enum": [
        "current",
        "stale",
        "detached"
      ],
      "type": "string"
    },
    "AutoReviewRunSource": {
      "enum": [
        "manual",
        "background"
      ],
      "type": "string"
    },
    "AutoReviewRunSummary": {
      "properties": {
        "budget": {
          "anyOf": [
            {
              "$ref": "#/definitions/AutoReviewBudget"
            },
            {
              "type": "null"
            }
          ]
        },
        "completedAt": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "content": {
          "type": "string"
        },
        "errorSummary": {
          "type": [
            "string",
            "null"
          ]
        },
        "findingDisposition": {
          "anyOf": [
            {
              "$ref": "#/definitions/AutoReviewFindingDispositionRecord"
            },
            {
              "type": "null"
            }
          ]
        },
        "freshness": {
          "$ref": "#/definitions/AutoReviewFreshness"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "omittedFindings": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "renderedFindings": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "runId": {
          "type": "string"
        },
        "source": {
          "$ref": "#/definitions/AutoReviewRunSource"
        },
        "startedAt": {
          "format": "int64",
          "type": "integer"
        },
        "status": {
          "$ref": "#/definitions/BackgroundAutoReviewStatus"
        },
        "terminalReason": {
          "anyOf": [
            {
              "$ref": "#/definitions/AutoReviewTerminalReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "usage": {
          "$ref": "#/definitions/AutoReviewUsage"
        }
      },
      "required": [
        "content",
        "freshness",
        "omittedFindings",
        "renderedFindings",
        "runId",
        "source",
        "startedAt",
        "status",
        "truncated",
        "usage"
      ],
      "type": "object"
    },
    "AutoReviewStatusCount": {
      "properties": {
        "count": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "freshness": {
          "$ref": "#/definitions/AutoReviewFreshness"
        },
        "source": {
          "$ref": "#/definitions/AutoReviewRunSource"
        },
        "status": {
          "$ref": "#/definitions/BackgroundAutoReviewStatus"
        },
        "targetMatches": {
          "type": "boolean"
        }
      },
      "required": [
        "count",
        "freshness",
        "source",
        "status",
        "targetMatches"
      ],
      "type": "object"
    },
    "AutoReviewTerminalReason": {
      "enum": [
        "budgetScope",
        "budgetElapsed",
        "budgetTotalTokens",
        "budgetOutput",
        "budgetFindingCount",
        "emptyOutput",
        "staleTarget"
      ],
      "type": "string"
    },
    "AutoReviewUsage": {
      "properties": {
        "elapsedMs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "findingCount": {
          "format": "uint",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "outputBytes": {
          "format": "uint",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "scopeBytes": {
          "format": "uint",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "totalTokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "BackgroundAutoReviewStatus": {
      "enum": [
        "pending",
        "running",
        "completed",
        "failed",
        "cancelled",
        "superseded",
        "skipped"
      ],
      "type": "string"
    }
  },
  "properties": {
    "current": {
      "anyOf": [
        {
          "$ref": "#/definitions/AutoReviewRunSummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "anyOf": [
        {
          "$ref": "#/definitions/AutoReviewDiagnosticsSummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "latest": {
      "anyOf": [
        {
          "$ref": "#/definitions/AutoReviewRunSummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "statusCounts": {
      "items": {
        "$ref": "#/definitions/AutoReviewStatusCount"
      },
      "type": "array"
    }
  },
  "required": [
    "statusCounts"
  ],
  "title": "AutoReviewSummaryReadResponse",
  "type": "object"
}
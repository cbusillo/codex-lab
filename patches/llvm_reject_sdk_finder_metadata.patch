diff --git a/directory.bzl b/directory.bzl
--- a/directory.bzl
+++ b/directory.bzl
@@ -3,6 +3,14 @@
 # We want to put a source directory into the DefaultInfo but still propagate
 # the DirectoryInfo for header inclusion checking.
 def headers_directory(name, path, visibility = None):
+    # DefaultInfo exports a whole directory, independently of the glob below.
+    # A glob exclusion alone cannot keep metadata out of action inputs. Reject
+    # contamination before SDK-wide recompilation; never mutate a shared SDK.
+    metadata_pattern = "**/.DS_Store" if path == "." else path + "/**/.DS_Store"
+    metadata = native.glob([metadata_pattern], allow_empty = True)
+    if metadata:
+        fail("SDK directory contains Finder metadata: %s. Stop browsing the extracted SDK in Finder; remove only these metadata files after active builds finish, then retry." % ", ".join(metadata[:5]))
+
     if path == ".":
         directory(
             name = name + "_directory",

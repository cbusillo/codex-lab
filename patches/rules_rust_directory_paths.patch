+                if target not in directories:
+                    fail("%s: $(directorypath %s) requires a DirectoryInfo target in data or tools" % (ctx.label, label))
+                expanded += "$${pwd}/" + directories[target].replace("$", "$$") + suffix
+        expanded_parts.append(expanded)
